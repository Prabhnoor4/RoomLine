# Which AI model to use, as "<provider>/<model name>" (LiteLLM format).
# The prefix picks the provider AND which key below actually needs to be real.
# Examples: anthropic/claude-sonnet-5, groq/llama-3.3-70b-versatile, openai/gpt-4o
LLM_MODEL=anthropic/claude-sonnet-5

# Only the key matching the provider prefix above needs a real value - the rest can stay blank
ANTHROPIC_API_KEY=sk-ant-your-key-here
GROQ_API_KEY=gsk-your-key-here
OPENAI_API_KEY=sk-your-key-here
